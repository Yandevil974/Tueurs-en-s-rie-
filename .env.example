# YANIS//X — configuration (copier en .env ; .env n'est jamais versionné)

# Base de données : chemin SQLite par défaut ; remplacer par une URL Postgres en production
YANISX_DB=./data/yanisx.sqlite3
# YANISX_DB=postgresql+psycopg://user:pass@host:5432/yanisx

# Répertoire des médias audio servis en HTTP Range
YANISX_MEDIA=./content/media

# Origines CORS autorisées, séparées par des virgules
YANISX_ORIGINS=http://localhost:5173
